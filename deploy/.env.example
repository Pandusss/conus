# install.sh writes this file for you. By hand: copy it to .env and fill it in.

# Letters and digits only (it goes into a connection URL as is), e.g. the output of: openssl rand -hex 24
POSTGRES_PASSWORD=
# Entered in the browser on the first visit, together with the owner password you choose. Empty: a random code
# is printed in the app's log (docker compose logs app).
CONUS_SETUP_CODE=
# en or ru: the language of what the server writes (chat notes, the agents' status line, task history).
CONUS_LANG=en

# Where people and agents reach the server. On this machine only:
CONUS_PUBLIC_URL=http://localhost:8080
# With the built-in HTTPS (Caddy gets a Let's Encrypt certificate; ports 80 and 443 must be free and the domain's
# A record must point at this server), uncomment:
# COMPOSE_PROFILES=https
# CONUS_DOMAIN=conus.example.com
# CONUS_PUBLIC_URL=https://conus.example.com

# The app's port on the host, and the address it listens on (127.0.0.1: reachable through a proxy only).
# CONUS_PORT=8080
# CONUS_BIND=127.0.0.1
# A released version instead of the latest one, e.g. 0.1.0
# CONUS_VERSION=latest

# Optional: the judge (Stop-hook check and task summaries). Without a key it is off; everything else works.
ANTHROPIC_API_KEY=
CONUS_JUDGE_ENABLED=true
CONUS_JUDGE_MODEL=claude-haiku-5-5
